  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "A staff browser reaches Apache on port 80; Apache proxies to the Flask process on localhost port 5010.",
        "Flask dispatches task creation, status changes, notes, and task-detail requests.",
        "The ORM persists task, user, pillar, dependency, and history records in MySQL."
      ]
    },
    {
      "dot": "emerald",
      "title": "Application behavior",
      "items": [
        "The app factory registers authentication, dashboard, task, API, and admin blueprints.",
        "Task mutations validate request values and commit through the shared SQLAlchemy session.",
        "The current user is loaded from the user model for session-backed routes."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust controls",
      "items": [
        "Browser task routes require a Flask-Login session; credential login checks an active user and password hash.",
        "The ingestion endpoint accepts only a configured API token, validates every batch item, and rolls back failed writes.",
        "The diagram distinguishes public/partner clients, the application host, and the database as separate trust boundaries."
      ]
    }
  ]
